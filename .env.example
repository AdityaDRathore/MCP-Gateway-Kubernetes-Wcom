# ==============================================================================
# Urumi Platform — Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development outside Kubernetes:
#   cp .env.example .env
#
# NOTE: In Kubernetes (k3d / production), environment variables are injected
# automatically via Helm values (values-local.yaml / values-prod.yaml) and
# Kubernetes Secret / ConfigMap manifests. Never commit a .env file containing
# real secrets to version control.
# ==============================================================================

# --- Node Environment ---
NODE_ENV=development

# --- Phase 1: MCP Echo Spike (spikes/mcp-echo) ---
# Required for running the protocol spike locally
MCP_SPIKE_API_KEY=test-spike-token-replace-me
PORT=7788
HOST=127.0.0.1
MCP_SERVER_URL=http://127.0.0.1:7788/mcp

# --- Phase 4 & 5: Team MCP Gateway Core ---
GATEWAY_PORT=8080
GATEWAY_HOST=127.0.0.1
GATEWAY_DB_PATH=./data/gateway.db
SYSTEM_SALT=urumi_local_development_salt_replace_in_prod

# --- Phase 2 & 3: WooCommerce Store & MCP Upstream ---
# Internal or local URL to the WordPress/WooCommerce instance
WOOCOMMERCE_URL=http://shop.127.0.0.1.nip.io:8080
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder_replace_with_real_key
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder_replace_with_real_secret

# --- Phase 6: In-Dashboard Chat Agent LLM Provider ---
# Recommended zero-cost option (15 RPM free tier via Google AI Studio):
GEMINI_API_KEY=your_gemini_api_key_here

# Optional commercial alternatives:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional local LLM alternative (requires running Ollama daemon):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
