{
  "name": "urumi-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Team MCP Gateway on Kubernetes with WooCommerce",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "mcp",
    "kubernetes",
    "gateway",
    "woocommerce"
  ],
  "author": "Aditya Rathore",
  "license": "UNLICENSED"
}
