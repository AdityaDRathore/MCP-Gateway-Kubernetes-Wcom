{
  "name": "gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Central Team MCP Gateway for Urumi Platform",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:protocol": "tsx --test --test-concurrency=1 test/protocol/*.test.ts",
    "test:benchmark": "tsx test/benchmarks/load-test.ts",
    "test": "npm run test:unit && npm run test:protocol",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "bootstrap:admin": "tsx src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
